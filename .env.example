# ─── X API (Required) ───────────────────────────────
X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
X_CALLBACK_URL=http://localhost:3400/auth/callback
X_USER_ID=your_numeric_user_id
X_USER_HANDLE=brandononchain

# ─── OAuth Tokens (Auto-populated after first auth) ──
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_TOKEN_EXPIRES_AT=

# ─── Server ─────────────────────────────────────────
PORT=3400
DB_PATH=./data/xenu.db

# ─── Optional: Sentiment Analysis ───────────────────
# Uses Claude API for mention sentiment. Leave blank to skip.
ANTHROPIC_API_KEY=
